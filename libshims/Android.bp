cc_library_shared {
    name: "libshim_fp",
    srcs: ["libshim_fp.c"],
    vendor: true,
}

cc_library_shared {
    name: "libshim_crypto",
    srcs: ["libshim_crypto.c"],
    shared_libs: ["libcrypto"],
    vendor: true,
}

cc_library_shared {
    name: "libshim_binder",
    srcs: ["libshim_binder.c"],
    version_script: "libshim_binder.map",
    vendor: true,
}

